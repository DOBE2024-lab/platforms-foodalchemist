{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "laravel/laravel",
    "type": "project",
    "description": "The skeleton application for the Laravel framework.",
    "keywords": [
        "laravel",
        "framework"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "laravel/framework": "^13.8",
        "laravel/passport": "^13.7",
        "laravel/tinker": "^3.0",
        "livewire/livewire": "*",
        "martin3r/platform-activity-log": "dev-main",
        "martin3r/platform-core": "dev-main",
        "martin3r/platform-crm": "dev-main",
        "martin3r/platform-foodalchemist": "dev-main",
        "martin3r/platform-integrations": "dev-main",
        "martin3r/platform-notifications": "dev-main",
        "martin3r/platform-organization": "dev-main",
        "martin3r/platform-ui-tailwind": "dev-main"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "laravel/pail": "^1.2.5",
        "laravel/pao": "^1.0.6",
        "laravel/pint": "^1.27",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "pestphp/pest": "^4.7",
        "pestphp/pest-plugin-laravel": "^4.1",
        "phpunit/phpunit": "^12.5.12"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/",
            "Platform\\FoodAlchemist\\Tests\\": "vendor/martin3r/platform-foodalchemist/tests/"
        }
    },
    "scripts": {
        "setup": [
            "composer install",
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan key:generate",
            "@php artisan migrate --force",
            "npm install --ignore-scripts",
            "npm run build"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "npx concurrently -c \"#93c5fd,#c4b5fd,#fb7185,#fdba74\" \"php artisan serve\" \"php artisan queue:listen --tries=1 --timeout=0\" \"php artisan pail --timeout=0\" \"npm run dev\" --names=server,queue,logs,vite --kill-others"
        ],
        "test": [
            "@php artisan config:clear --ansi @no_additional_args",
            "@php artisan test"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        },
        "audit": {
            "block-insecure": false
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "repositories": [
        {
            "type": "path",
            "url": "../platform/modules/platforms-foodalchemist",
            "options": {
                "symlink": true
            }
        },
        {
            "type": "path",
            "url": "../platform/modules/platforms-core",
            "options": {
                "symlink": true
            }
        },
        {
            "type": "path",
            "url": "../styles/platforms-ui-tailwind",
            "options": {
                "symlink": true
            }
        },
        {
            "type": "path",
            "url": "../platform/modules/platforms-activity-log",
            "options": {
                "symlink": true
            }
        },
        {
            "type": "path",
            "url": "../platform/modules/platform-crm",
            "options": {
                "symlink": true
            }
        },
        {
            "type": "path",
            "url": "../platform/modules/platforms-organization",
            "options": {
                "symlink": true
            }
        },
        {
            "type": "path",
            "url": "../platform/modules/platforms-notifications",
            "options": {
                "symlink": true
            }
        },
        {
            "type": "path",
            "url": "../platform/modules/platforms-integrations",
            "options": {
                "symlink": true
            }
        }
    ]
}
